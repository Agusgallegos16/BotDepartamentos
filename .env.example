# ==============================================================================
# CONFIGURACIÓN DEL BOT DE DEPARTAMENTOS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales de Telegram
# ------------------------------------------------------------------------------
# Creá tu bot con @BotFather en Telegram y pegá el token aquí.
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN_AQUI

# Obtené tu chat ID enviándole un mensaje a @userinfobot en Telegram.
TELEGRAM_CHAT_ID=TU_TELEGRAM_CHAT_ID_AQUI

# ------------------------------------------------------------------------------
# 2. Filtros Generales de Búsqueda
# ------------------------------------------------------------------------------
# Presupuesto máximo total en ARS (Alquiler + Expensas). Si las expensas no están
# informadas, se evalúa solo el valor del alquiler contra este tope.
MAX_TOTAL_BUDGET_ARS=1100000

# Cantidad mínima de ambientes (ej. 2 para 2 ambientes o más).
MIN_ROOMS=2

# Barrios objetivo (separados por coma).
# Opciones soportadas: palermo, caballito, villa-urquiza, villa-del-parque,
# chacarita, belgrano, recoleta, colegiales, villa-crespo
TARGET_NEIGHBORHOODS=palermo,caballito,villa-urquiza,villa-del-parque,chacarita,belgrano,recoleta,colegiales,villa-crespo

# ------------------------------------------------------------------------------
# 3. Ajustes de Scraping y Red
# ------------------------------------------------------------------------------
# Timeout para cada solicitud HTTP en segundos
REQUEST_TIMEOUT=25

# Pausa entre requests para no saturar servidores (segundos)
DELAY_BETWEEN_REQUESTS=2.0

# Portales activos (separados por coma: zonaprop,mercadolibre,remax,argenprop,mob,cabaprop,directoaldueno,roomix)
ACTIVE_PORTALS=zonaprop,mercadolibre,remax,argenprop,mob,cabaprop,directoaldueno,roomix
